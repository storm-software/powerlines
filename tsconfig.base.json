{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@storm-software/tsconfig/recommended.json",
  "display": "Powerlines - TypeScript Monorepo",
  "compilerOptions": {
    "ignoreDeprecations": "6.0",
    "incremental": true,
    "composite": true,
    "rootDir": ".",
    "module": "esnext",
    "types": ["node"],
    "declaration": true,
    "declarationMap": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": false
  }
}
