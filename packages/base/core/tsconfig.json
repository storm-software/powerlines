{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ESNext"],
    "rootDir": "../../..",
    "types": ["node", "./types/prettier-plugin-organize-imports.d.ts"],
    "strict": true,
    "outDir": "../../../dist/out-tsc",
    "ignoreDeprecations": "6.0"
  },
  "include": [
    "src/**/*.ts",
    "schemas/**/*.ts",
    "types/**/*.d.ts",
    "tsdown.config.ts"
  ],
  "exclude": ["vitest.config.mts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
