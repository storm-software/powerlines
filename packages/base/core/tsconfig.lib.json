{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "rootDir": ".",
    "types": ["node", "./types/prettier-plugin-organize-imports.d.ts"],
    "strict": true,
    "outDir": "./out-tsc"
  },
  "references": [
    {
      "path": "../../../tools/config"
    }
  ],
  "include": [
    "src/**/*.ts",
    "schemas/**/*.ts",
    "types/**/*.d.ts",
    "tsdown.config.ts"
  ],
  "exclude": [
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "out-tsc",
    "dist"
  ]
}
