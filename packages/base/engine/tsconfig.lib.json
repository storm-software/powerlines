{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "lib": ["ESNext"],
    "rootDir": ".",
    "types": ["node"],
    "strict": true,
    "outDir": "./out-tsc"
  },
  "references": [
    {
      "path": "../core/tsconfig.lib.json"
    },
    {
      "path": "../../../tools/config"
    }
  ],
  "include": ["src/**/*.ts", "tsdown.config.ts"],
  "exclude": ["vitest.config.mts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
