{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "rootDir": ".",
    "types": ["node"],
    "strict": true,
    "outDir": "./out-tsc"
  },
  "references": [
    { "path": "../../devkit/powerlines/tsconfig.lib.json" },
    { "path": "../plugin-vite/tsconfig.lib.json" },
    { "path": "../plugin-plugin/tsconfig.lib.json" }
  ],
  "include": ["src/**/*.ts", "powerlines.config.ts", "powerlines.d.ts"],
  "exclude": ["vitest.config.mts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
