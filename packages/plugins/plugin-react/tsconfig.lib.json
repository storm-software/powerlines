{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "jsx": "preserve",
    "jsxImportSource": "@alloy-js/core",
    "lib": ["esnext"],
    "rootDir": ".",
    "types": ["node"],
    "strict": false,
    "outDir": "./out-tsc"
  },
  "references": [
    { "path": "../../devkit/powerlines/tsconfig.lib.json" },
    { "path": "../plugin-vite/tsconfig.lib.json" },
    { "path": "../plugin-env/tsconfig.lib.json" },
    { "path": "../plugin-babel/tsconfig.lib.json" },
    { "path": "../plugin-alloy/tsconfig.lib.json" },
    { "path": "../../base/core/tsconfig.lib.json" },
    { "path": "../plugin-plugin/tsconfig.lib.json" }
  ],
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "powerlines.config.ts",
    "powerlines.d.ts"
  ],
  "exclude": ["vitest.config.mts", "src/**/*.spec.ts", "src/**/*.test.ts"]
}
