{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@alloy-js/core",
    "lib": [
      "esnext"
    ],
    "types": [
      "node"
    ],
    "outDir": "../../../dist/out-tsc",
    "ignoreDeprecations": "6.0",
    "composite": true,
    "incremental": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "powerlines.config.ts",
    "powerlines.d.ts"
  ],
  "exclude": [
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../devkit/powerlines"
    },
    {
      "path": "../../base/core"
    },
    {
      "path": "../plugin-alloy"
    },
    {
      "path": "../plugin-automd"
    },
    {
      "path": "../plugin-babel"
    },
    {
      "path": "../plugin-plugin"
    },
    {
      "path": "../plugin-power-plant"
    }
  ]
}
