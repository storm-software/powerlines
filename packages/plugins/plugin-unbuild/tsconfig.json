{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": [
      "node"
    ],
    "outDir": "../../../dist/out-tsc",
    "ignoreDeprecations": "6.0",
    "composite": true,
    "incremental": true
  },
  "include": [
    "src/**/*.ts",
    "powerlines.config.ts",
    "powerlines.d.ts"
  ],
  "exclude": [
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../devkit/powerlines"
    },
    {
      "path": "../../base/core"
    },
    {
      "path": "../../devkit/unplugin"
    }
  ]
}
