    },
    "./helpers/storage-adapter": {
      "require": {
        "types": "./dist/helpers/storage-adapter.d.cts",
        "default": "./dist/helpers/storage-adapter.cjs"
      },
      "import": {
        "types": "./dist/helpers/storage-adapter.d.mts",
        "default": "./dist/helpers/storage-adapter.mjs"
      },
      "default": {
        "types": "./dist/helpers/storage-adapter.d.mts",
        "default": "./dist/helpers/storage-adapter.mjs"
      }
    },
    "./package.json": "./package.json",
    "./types": {
      "require": {
        "types": "./dist/types/index.d.cts",
        "default": "./dist/types/index.cjs"
      },
      "import": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/types/index.mjs"
      },
      "default": {
        "types": "./dist/types/index.d.mts",
        "default": "./dist/types/index.mjs"
      }
    },
    "./types/plugin": {
      "require": {
        "types": "./dist/types/plugin.d.cts",
        "default": "./dist/types/plugin.cjs"
      },
      "import": {
        "types": "./dist/types/plugin.d.mts",
        "default": "./dist/types/plugin.mjs"
      },
      "default": {
        "types": "./dist/types/plugin.d.mts",
        "default": "./dist/types/plugin.mjs"
      }
    }
  },
  "typings": "dist/index.d.mts",
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "power-plant",
    "powerlines",
    "storm-software",
    "powerlines-plugin"
  ],
  "dependencies": {
    "@power-plant/core": "catalog:",
    "@stryke/string-format": "catalog:",
    "@stryke/type-checks": "catalog:",
    "powerlines": "workspace:*",
    "unstorage": "catalog:"
  },
  "devDependencies": {
    "@powerlines/plugin-plugin": "workspace:*",
    "@types/node": "catalog:"
