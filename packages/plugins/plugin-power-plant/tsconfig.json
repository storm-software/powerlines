{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "outDir": "../../../dist/out-tsc",
    "ignoreDeprecations": "6.0",
    "composite": true,
    "incremental": true
  },
  "include": [
    "src/**/*.ts",
    "types/**/*.d.ts",
    "powerlines.config.ts",
    "powerlines.d.ts"
  ],
  "exclude": ["vitest.config.mts", "src/**/*.spec.ts", "src/**/*.test.ts"],
  "reflection": true,
  "references": [
    {
      "path": "../../devkit/unplugin"
    },
    {
      "path": "../../devkit/powerlines"
    },
    {
      "path": "../plugin-plugin"
    }
  ]
}
