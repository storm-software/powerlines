{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "target": "esnext",
    "jsx": "preserve",
    "jsxImportSource": "@alloy-js/core",
    "lib": [
      "ESNext"
    ],
    "rootDir": "../..",
    "types": [
      "node"
    ],
    "declaration": true,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "composite": true,
    "incremental": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "powerlines.config.ts",
    "powerlines.d.ts"
  ],
  "exclude": [
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../devkit/powerlines"
    },
    {
      "path": "../plugin-tsdown"
    }
  ]
}
