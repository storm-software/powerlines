{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "target": "ESNext",
    "lib": ["ESNext"],
    "moduleDetection": "force",
    "rootDir": ".",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": false,
    "outDir": "./out-tsc",
    "skipDefaultLibCheck": true,
    "skipLibCheck": true
  },
  "references": [
    {
      "path": "../powerlines/tsconfig.lib.json"
    },
    {
      "path": "../../../tools/config"
    }
  ],
  "include": [
    "src/**/*.json",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "tsdown.config.mjs"
  ],
  "exclude": [
    "vitest.config.mts",
    "src/generators/**/files/**/*",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "out-tsc",
    "dist"
  ]
}
