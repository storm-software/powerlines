{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "@alloy-js/core",
    "types": ["node"],
    "outDir": "./out-tsc",
    "composite": true,
    "incremental": true,
    "resolveJsonModule": true,
    "rootDir": "."
  },
  "include": ["src/**/*.ts", "shell-shock.config.ts", "shell-shock.d.ts"],
  "exclude": [
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "out-tsc",
    "dist"
  ],
  "references": [
    {
      "path": "../powerlines/tsconfig.lib.json"
    }
  ]
}
