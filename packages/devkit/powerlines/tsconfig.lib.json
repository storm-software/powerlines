{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true,
    "composite": true,
    "lib": ["ESNext"],
    "rootDir": ".",
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true,
    "outDir": "./out-tsc"
  },
  "references": [
    {
      "path": "../unplugin/tsconfig.lib.json"
    },
    {
      "path": "../../base/engine/tsconfig.lib.json"
    },
    {
      "path": "../../base/core/tsconfig.lib.json"
    },
    {
      "path": "../../../tools/config"
    }
  ],
  "include": ["src/**/*.ts", "tsdown.config.ts"],
  "exclude": [
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "out-tsc",
    "dist"
  ]
}
