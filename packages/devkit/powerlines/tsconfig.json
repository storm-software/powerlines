{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": [
      "ESNext"
    ],
    "rootDir": "../../../",
    "types": [
      "node"
    ],
    "strict": true,
    "outDir": "../../../dist/out-tsc",
    "ignoreDeprecations": "6.0",
    "composite": true,
    "incremental": true,
    "resolveJsonModule": true
  },
  "include": [
    "src/**/*.ts",
    "tsdown.config.ts",
    "**/*.json",
    "package.json"
  ],
  "exclude": [
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts"
  ],
  "references": [
    {
      "path": "../../base/core"
    },
    {
      "path": "../../base/engine"
    },
    {
      "path": "../unplugin"
    },
    {
      "path": "../../../tools/config"
    }
  ]
}
