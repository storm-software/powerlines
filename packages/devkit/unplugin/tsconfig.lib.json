{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "tsBuildInfoFile": "out-tsc/tsconfig.tsbuildinfo",
    "rootDir": ".",
    "types": ["node"],
    "outDir": "./out-tsc"
  },
  "references": [
    {
      "path": "../../base/core/tsconfig.lib.json"
    },
    {
      "path": "../../../tools/config"
    }
  ],
  "include": ["src/**/*.ts", "tsdown.config.ts"],
  "exclude": [
    "vitest.config.mts",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "out-tsc",
    "dist"
  ]
}
